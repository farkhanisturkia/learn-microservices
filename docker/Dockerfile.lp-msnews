FROM node:lts-alpine AS build
WORKDIR /app

COPY services/frontend/lp-msnews/package*.json ./
RUN npm install

COPY services/frontend/lp-msnews/ ./
RUN npm run build

FROM nginx:alpine

RUN rm /etc/nginx/conf.d/default.conf

COPY nginx/msnews.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]